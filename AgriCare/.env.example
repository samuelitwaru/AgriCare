SECRET_KEY=change-me-to-a-random-secret-in-local-env
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset to use local SQLite.
# For Postgres + PostGIS (recommended once geospatial work starts):
# DATABASE_URL=postgis://agricare:agricare@localhost:5432/agricare
GIS_ENABLED=False

CORS_ALLOWED_ORIGINS=http://localhost:3000

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=

# Google Earth Engine (CHIRPS rainfall / NDVI ingestion).
# Create a service account in a Google Cloud project with Earth Engine API
# enabled, download its JSON key, and point EE_SERVICE_ACCOUNT_KEY_FILE at it.
EE_SERVICE_ACCOUNT_EMAIL=
EE_SERVICE_ACCOUNT_KEY_FILE=
EE_PROJECT_ID=
